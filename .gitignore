# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# start.bat 自動建的專案私有環境（每台機器自己裝，不進 git）
.venv/
venv/

# 模型權重（太大不進 git；放 weights/ 即可被程式讀到）
*.pt
weights/*

# 執行期資料（校正結果、檢查清單狀態、log）
data/
config/local.yaml
config/camera_intrinsics.yaml
*.log

# 訓練輸出（權重、曲線圖；每次訓練都會重生）
runs/

# 暫存
.tmp*/
.vscode/
.idea/
